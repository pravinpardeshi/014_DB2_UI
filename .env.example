# Mainframe ODBC Connection Settings
# ODBC driver name varies by platform:
#   Windows:  {IBM DB2 ODBC DRIVER}
#   Linux:    {IBM DB2 ODBC DRIVER} or /opt/ibm/db2-clidriver/lib64/libdb2o.so
#   macOS:    {IBM DB2 ODBC DRIVER}
ODBC_DRIVER={IBM DB2 ODBC DRIVER}
ODBC_HOST=mainframe-host.example.com
ODBC_PORT=50000
ODBC_DATABASE=MFGDB
ODBC_UID=your_username
ODBC_PWD=your_password

# FastAPI Settings
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

# Application Mode: demo (sample data) or production (live ODBC)
APP_MODE=demo
